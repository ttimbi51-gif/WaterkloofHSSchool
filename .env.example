# Copy this file to .env and fill in the values.
# Use your actual Outlook / Microsoft 365 SMTP credentials or another SMTP provider.

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-outlook-email@outlook.com
SMTP_PASS=your-outlook-email-password-or-app-password

SENDER_EMAIL=your-outlook-email@outlook.com
RECEIVER_EMAIL=whss.finance@outlook.com
EMAIL_SUBJECT=Admission Application from Website

# PayFast settings
PAYFAST_BASE_URL=https://sandbox.payfast.co.za/eng/process
PAYFAST_MERCHANT_ID=your_payfast_merchant_id
PAYFAST_MERCHANT_KEY=your_payfast_merchant_key
PAYFAST_PASSPHRASE=your_payfast_passphrase
PAYFAST_NOTIFY_URL=http://127.0.0.1:3000/api/payfast-notify
PAYFAST_RETURN_URL=http://127.0.0.1:3000/api/payfast-return?m_payment_id={m_payment_id}
PAYFAST_CANCEL_URL=http://127.0.0.1:3000/payment.html?appId={m_payment_id}
ADMISSION_FEE=140.00

# Twilio WhatsApp settings (optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+2771xxxxxxx
ADMIN_PHONE=whatsapp:+27xxxxxxxxx

# Local server settings
SITE_ROOT=http://127.0.0.1:3000
PORT=3000
